# Copy this file to sensly.conf and fill in your broker details.
# Then run:  python3 Sensly.py --mqtt

[mqtt]
# IP address or hostname of the machine running Home Assistant / Mosquitto
host = homeassistant.local
port = 1883

# A Home Assistant user account. The Mosquitto add-on authenticates MQTT
# clients against Home Assistant users, so create one for the Pi under
# Settings -> People -> Users (e.g. "sensly") and put it here.
username =
password =

# Optional. Change device_id only if you run more than one Sensly HAT.
device_id = sensly_hat
device_name = Sensly HAT
discovery_prefix = homeassistant

[calibration]
# Added to the BME280 readings. The BME280 sits next to three heated gas
# sensors and reads warm, so the temperature offset is normally negative.
# Compare against a trusted thermometer in the same room once the HAT has
# been running for an hour, and set the difference here.
temperature_offset = -10.6
humidity_offset = 0

[sensors]
# The Sensly HAT has a "PM 2.5 Header" for an optional particulate sensor.
# Set to no if nothing is plugged into it, otherwise PM10 always reads 0.
pm_attached = yes

# Written automatically by Sensly_Calibration.py. Leave out to use the
# built-in defaults, which came from the original author's board.
# r0_mq2 = 3120.5
# r0_mq7 = 1258.9
# r0_mq135 = 2786.3

# CO2 reference anchor. The original MQ135 lookup table only reports CO2
# once the air is already stale and shows 0 in clean air. Setting both of
# these switches to a curve anchored to a trusted CO2 meter: note the MQ135
# RS/R0 ratio (sensor.sensly_hat_mq135_rs_r0 in Home Assistant, averaged
# over a few minutes) at the same time the reference meter reads co2_ref_ppm.
# co2_ref_ppm = 440
# co2_ref_ratio = 2.72
# co2_exponent = -2.7979
